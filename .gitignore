**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.next/
**/.vinext/
**/.wrangler/
**/.sites-runtime/
**/.openai/
**/dist/
**/build/
**/outputs/
**/logs/
**/tmp/
**/temp/
**/.env
**/.env.*
!**/.env.example
**/.dev.vars*
**/.npmrc
**/.netrc
**/.pypirc
**/credentials*
**/inference-token*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.sqlite*
**/*.db
**/*.log
**/*.tsbuildinfo
**/checkpoints/
