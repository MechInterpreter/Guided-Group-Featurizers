  "image_split": "Deterministic first 200/200 split with >=3 positive-mask images/category in each half. No method outputs used in splitting.",
  "primary_readouts": "Existing TRAIN-selected contrast groups for BSFs, existing native category dictionaries/tokens for comparators. No new best-group selection on evaluation images.",
  "group_fingerprints": "Per-category instance-contrast Capture, raw response patch AP and above-prevalence AP uplift. All signed Capture values retained. Positive Capture and AP uplift profiles analyzed separately.",
  "direction_fingerprints": "All 12 coordinates in linear BSF/SLiCS groups: category-wise leave-one-direction-out change in single-group Capture, plus foreground-minus-same-image-background absolute coefficient response.",
  "direction_agreement": "Cross-half cosine of positive category profiles, averaged over every distinct direction pair within a group. Missing/zero positive profiles earn zero. Both orientations averaged. Also retain signed raw profiles.",
  "null_control": "100 fixed permutations of direction identities within activity deciles, preserving widths and approximate slot activity. Same permutation applied to both halves. Report observed minus null mean. Activity bins derived from half A only. This is a descriptive control, not a calibrated hypothesis test.",
  "group_stability": "Cosine of independently measured A/B profiles, with 100 fixed random category-permutation controls. Category-aligned zero profiles earn zero.",
  "specificity": "Largest positive category weight / total positive weight, alongside positive support and performance. Specificity alone is not semantic coherence.",
  "thresholds": {
    "positive_fraction": 0.5,
    "negative_fraction": 0.1,
    "min_foreground_mass": 1,
    "min_background_patches": 8,
    "min_contrast_images_per_half": 3
  },
  "detection": "All 196 patches, crowd > .1 ignored, .1<category coverage<.5 ignored, tied scores handled exactly. No logistic heads.",
  "direction_comparison_scope": "Four linear block methods only. No invented scalar directions for Concept-SAE. Free Concept-SAE tokens included in all-unit outputs but primary readouts remain the 75 category tokens.",
  "reconstruction_scope": "SLiCS dictionaries are independent projections and are not summed as a joint additive reconstruction.",
